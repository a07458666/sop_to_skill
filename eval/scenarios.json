    },
    {
      "name": "coater: equipment issue, recovery verified -> release",
      "flow": "skills/photoresist_coater_defect/flow.json",
      "split": "holdout",
      "expected_end_state": "release_coater_to_production",
      "situation": {
        "confirm_defect_signal": "coating defect is confirmed",
        "hold_affected_tool_and_lots": "containment is complete",
        "review_coater_process_data": "abnormal process signal is found",
        "run_coater_diagnostics": "equipment issue is identified",
        "create_corrective_action": "corrective action is approved",
        "verify_coater_recovery": "verification passes"
      }
    },
    {
      "name": "auto-notify (MCP): anomaly confirmed, owner acknowledges -> hand off",
      "flow": "skills/tool_anomaly_auto_notification/flow.json",
      "split": "dev",
      "expected_end_state": "hand_off_to_owner",
      "situation": {
